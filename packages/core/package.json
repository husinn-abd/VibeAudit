{
  "name": "@vibeaudit/core",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "import": "./dist/markdown.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vibeaudit/security": "workspace:*",
    "dotenv": "^16.6.1",
    "zod": "^3.24.1"
  }
}
