# Copy this file to .env before running local services.
# Do not commit real secrets. All real .env files are ignored by git.

# API service
VIBEAUDIT_API_HOST=0.0.0.0
VIBEAUDIT_API_PORT=4317
VIBEAUDIT_API_LOGGER=true
VIBEAUDIT_API_MAX_IMPORT_BYTES=10485760

# Local database used by Prisma from apps/api/prisma/schema.prisma.
DATABASE_URL=file:./dev.db

# Seeded local/demo organization and project.
VIBEAUDIT_DEFAULT_ORGANIZATION_ID=org_default
VIBEAUDIT_DEFAULT_ORGANIZATION_NAME=Default Organization
VIBEAUDIT_DEFAULT_PROJECT_ID=proj_vibeaudit_demo
VIBEAUDIT_DEFAULT_PROJECT_NAME=VibeAudit Demo
VIBEAUDIT_DEFAULT_REPOSITORY_URL=https://github.com/husinn-abd/VibeAudit

# Web dashboard. Only variables prefixed with VITE_ are exposed to browser code.
VITE_API_BASE_URL=http://localhost:4317
VITE_ORGANIZATION_ID=org_default
VITE_PROJECT_ID=proj_vibeaudit_demo
VITE_DEMO_MODE=true

# Runner defaults.
VIBEAUDIT_SCANNER_TIMEOUT_MS=480000
VIBEAUDIT_MAX_REPO_BYTES=536870912
VIBEAUDIT_RUNNER_OUTPUT=artifacts/vibeaudit-report.json
VIBEAUDIT_RUNNER_SARIF=artifacts/vibeaudit-report.sarif
VIBEAUDIT_RUNNER_MARKDOWN=artifacts/vibeaudit-report.md

# Optional upload target for manual runner usage.
# Keep blank unless you have an API import endpoint ready.
VIBEAUDIT_UPLOAD_URL=

# Optional AI settings reserved for the post-MVP local OpenAI-compatible flow.
VIBEAUDIT_AI_MODE=disabled
VIBEAUDIT_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
VIBEAUDIT_OPENAI_COMPATIBLE_API_KEY=replace-me
