# Optional API-specific overrides.
# Root .env is loaded first; apps/api/.env can override root .env values.

VIBEAUDIT_API_HOST=0.0.0.0
VIBEAUDIT_API_PORT=4317
VIBEAUDIT_API_LOGGER=true
VIBEAUDIT_API_MAX_IMPORT_BYTES=10485760
DATABASE_URL=file:./dev.db

VIBEAUDIT_DEFAULT_ORGANIZATION_ID=org_default
VIBEAUDIT_DEFAULT_ORGANIZATION_NAME=Default Organization
VIBEAUDIT_DEFAULT_PROJECT_ID=proj_vibeaudit_demo
VIBEAUDIT_DEFAULT_PROJECT_NAME=VibeAudit Demo
VIBEAUDIT_DEFAULT_REPOSITORY_URL=https://github.com/husinn-abd/VibeAudit
